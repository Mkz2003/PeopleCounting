{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMSIS-DAP Debug (H7) (Debug Only --Release)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "serverpath": "E:/Program Files/OpenOCD-20251211-0.12.0/bin/openocd.exe",
            "configFiles": [
                "${workspaceFolder}/cmsis-dap.cfg"
            ],
            "executable": "${workspaceFolder}/build/Release/${workspaceFolderBasename}.elf",
            "device": "STM32H743xx",
            "svdPath": "${workspaceFolder}/STM32H743.svd"
        },
        {
            "name": "CMSIS-DAP Debug (H7) (Flash and Debug)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "serverpath": "E:/Program Files/OpenOCD-20251211-0.12.0/bin/openocd.exe",
            "configFiles": [
                "${workspaceFolder}/cmsis-dap.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "build to debug",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "device": "STM32H743xx",
            "svdPath": "${workspaceFolder}/STM32H743.svd"
        },
        {
            "name": "OpenOCD Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "svdPath": "${workspaceFolder}/STM32H743.svd",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Set remote target to port 3333",
                    "text": "target remote :3333",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}